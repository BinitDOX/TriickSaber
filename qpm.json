{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.3.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "TriickSaber",
    "id": "TriickSaber",
    "version": "0.3.0",
    "url": null,
    "additionalData": {
      "overrideSoName": "libTriickSaber.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh build.ps1"
      ],
      "clean": [
        "pwsh build.ps1 -clean"
      ],
      "copy": [
        "pwsh copy.ps1"
      ],
      "log": [
        "pwsh start-logging.ps1"
      ],
      "qmod": [
        "pwsh createqmod.ps1"
      ],
      "restart": [
        "pwsh restart-game.ps1"
      ],
      "stack": [
        "pwsh ndk-stack.ps1"
      ],
      "tomb": [
        "pwsh pull-tombstone.ps1"
      ]
    },
    "ndk": "^27.3.13750724",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./TriickSaber.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.2",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "4008.*",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.18.3",
      "additionalData": {}
    },
    {
      "id": "config-utils",
      "versionRange": "^2.0.3",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.4.55",
      "additionalData": {}
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.6.4",
      "additionalData": {
        "private": true
      }
    },
    {
      "id": "metacore",
      "versionRange": "^1.6.2",
      "additionalData": {}
    }
  ]
}